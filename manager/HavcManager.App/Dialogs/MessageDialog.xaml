<Window x:Class="HavcManager.App.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/Resources/havc.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"/>
        <TextBlock x:Name="LinkBlock" Margin="0,10,0,0" Visibility="Collapsed">
            <Hyperlink x:Name="LinkElement" Click="OnLinkClick"><Run x:Name="LinkRun"/></Hyperlink>
        </TextBlock>
        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
