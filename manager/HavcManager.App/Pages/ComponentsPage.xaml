<UserControl x:Class="HavcManager.App.Pages.ComponentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HavcManager.App.Resources">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static res:Strings.ComponentsTitle}"
                   FontSize="22" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{x:Static res:Strings.ComponentsServerGui}" FontSize="14"/>
            <TextBlock Text="{x:Static res:Strings.ComponentsDinov2}" FontSize="14" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding ModelsDir, StringFormat=Models folder: {0}}"
                       Opacity="0.7" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Back}" Padding="16,8" Margin="0,0,8,0"
                    Click="OnBackClick"/>
            <Button Content="{x:Static res:Strings.Continue}" Padding="16,8"
                    Click="OnContinueClick"/>
        </StackPanel>
    </Grid>
</UserControl>
