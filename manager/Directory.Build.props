<Project>

  <!-- Shared settings for the HAVC Manager solution (spec: installer/PHASE1_SPEC.md §2). -->
  <PropertyGroup>
    <!-- The manager has its own version, independent from the havc package. -->
    <Version>2.0.1</Version>
    <Product>HAVC Manager</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
