<UserControl x:Class="HavcManager.App.Pages.PreflightPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HavcManager.App.Resources"
             xmlns:app="clr-namespace:HavcManager.App">
    <UserControl.Resources>
        <app:PreflightStatusGlyphConverter x:Key="StatusGlyph"/>
        <app:PreflightStatusBrushConverter x:Key="StatusBrush"/>
    </UserControl.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static res:Strings.PreflightTitle}"
                   FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                   Opacity="0.75" Margin="0,8,0,0"/>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding PreflightChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                               Opacity="0.72" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SuggestedBackendText}" Margin="0,14,0,0"
                           Opacity="0.75" FontStyle="Italic"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Back}" Padding="16,8" Margin="0,0,8,0"
                    Click="OnBackClick"/>
            <Button Content="{x:Static res:Strings.Continue}" Padding="16,8"
                    Click="OnContinueClick" IsEnabled="{Binding CanContinueFromPreflight}"/>
        </StackPanel>
    </Grid>
</UserControl>
