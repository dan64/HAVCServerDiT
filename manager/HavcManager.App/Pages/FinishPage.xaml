<UserControl x:Class="HavcManager.App.Pages.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HavcManager.App.Resources">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static res:Strings.FinishTitle}"
                   FontSize="24" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{Binding FinishVersionText}" FontSize="14"/>
            <TextBlock Text="{Binding InstallDir}" Opacity="0.7" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.OpenGui}" Padding="16,9"
                    Margin="0,0,8,8" Click="OnOpenGuiClick"/>
            <Button Content="{x:Static res:Strings.StartServerButton}" Padding="16,9"
                    Margin="0,0,8,8" Click="OnStartServerClick"/>
            <Button Content="{x:Static res:Strings.OpenWorkFolderButton}" Padding="16,9"
                    Margin="0,0,8,8" Click="OnOpenFolderClick"/>
            <Button Content="{x:Static res:Strings.ShowLogButton}" Padding="16,9"
                    Margin="0,0,8,8" Click="OnShowLogClick"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.Close}" Padding="16,8" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</UserControl>
