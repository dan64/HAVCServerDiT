<Window x:Class="HavcManager.App.Dialogs.ProcessLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:HavcManager.App.Resources"
        Title="{x:Static res:Strings.LockDialogTitle}"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/Resources/havc.ico">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static res:Strings.LockDialogText}" TextWrapping="Wrap" FontSize="13"/>
        <ItemsControl x:Name="ProcessList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Margin="0,1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True"
                    Padding="14,7" Margin="0,0,8,0" Click="OnCancelClick"/>
            <Button Content="{x:Static res:Strings.TerminateButton}"
                    Padding="14,7" Margin="0,0,8,0" Click="OnTerminateClick"/>
            <Button Content="{x:Static res:Strings.RetryButton}" IsDefault="True"
                    Padding="14,7" Click="OnRetryClick"/>
        </StackPanel>
    </StackPanel>
</Window>
