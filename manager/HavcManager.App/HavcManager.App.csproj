<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Installer icon (repository file: installer/Icona-havc-dit.ico). -->
    <ApplicationIcon>..\..\installer\Icona-havc-dit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon as a WPF resource for Window.Icon (title bar). -->
    <Resource Include="..\..\installer\Icona-havc-dit.ico" Link="Resources\havc.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HavcManager.Core\HavcManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources\Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
